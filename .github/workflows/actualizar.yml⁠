name: Actualizar Web Diaria

on:
  schedule:
    - cron: '0 8 * * *' # Corre todos los días a las 8:00 AM
  workflow_dispatch: # Permite correrlo a mano desde el celular cuando quieras

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Copiar repositorio
        uses: actions/checkout@v3

      - name: Configurar Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Ejecutar script generador
        run: python generador.py

      - name: Subir cambios automáticamente
        uses: stefanzweifel/git-auto-commit-action@v4
        with:
          commit_message: "Actualización automática de contenido diario"
          branch: main
